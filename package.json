{
  "name": "linkforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "start": "npm start --workspace server",
    "build": "npm run build --workspace web",
    "test": "npm test --workspace server && node --test tests/integration/*.test.js",
    "test:integration": "RUN_INTEGRATION=1 node --test tests/integration/*.test.js"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
